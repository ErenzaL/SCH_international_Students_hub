# =============================================================================
# SCH International Student Hub - environment variables (copy to .env, never commit .env)
# Backend reads ./.env or backend/.env ; the web app reads apps/web/.env.local
# =============================================================================

# ---- Backend (FastAPI) : SERVER-SIDE ONLY ------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server secret / service-role key. NEVER put this in the browser or in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects (Project Settings > API > JWT Secret). Projects with asymmetric
# signing keys are verified automatically through the JWKS endpoint; leave empty then.
SUPABASE_JWT_SECRET=
# Comma-separated, no trailing slash. CORS_ALLOWED_ORIGINS is accepted as an alias.
CORS_ORIGINS=http://localhost:3000
# Trusted domains the ingestion fetcher may contact (exact or subdomain match)
ALLOWED_SOURCE_DOMAINS=sch.ac.kr,studyinkorea.go.kr,hikorea.go.kr,topik.go.kr,nhis.or.kr,moel.go.kr
MAX_UPLOAD_MB=10
MAX_RESPONSE_MB=5
LOG_LEVEL=INFO

# Embeddings: e5 = intfloat/multilingual-e5-small (384-d, needs requirements-ml.txt)
#             hash = lexical stand-in for tests/offline dev ONLY (not semantic)
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
# Semantic-only matches below this cosine similarity are dropped (E5 scores cluster high; tune on real data)
RETRIEVAL_MIN_SIMILARITY=0.80

# Optional, future phase (answer generation). Core site works without it.
LLM_PROVIDER=none                 # none | gemini | anthropic | ollama (local development only)
LLM_API_KEY=                      # server-side secret (Gemini or Anthropic key); never commit a real value
# BACKGROUND_LLM_PROVIDER=        # translation drafts + agent summaries only; empty = LLM_PROVIDER (docs/ollama.md)
# OLLAMA_BASE_URL=http://127.0.0.1:11434   # loopback only
# OLLAMA_MODEL=qwen2.5:7b-instruct
# GPU_WORKER_ENABLED=false        # university GPU worker for translation drafts (docs/gpu-worker.md, migration 0016)
# GEMINI_PRIMARY_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low       # minimal | low | medium | high
# LLM_TEMPERATURE=                # empty = model default
# LLM_REQUEST_TIMEOUT_SECONDS=30
# LLM_MAX_ATTEMPTS_PER_MODEL=2
# AI_DAILY_LIMIT_PER_CLIENT=40    # anonymous, per client IP / KST day
# AI_DAILY_LIMIT_PER_USER=150
# AI_DAILY_LIMIT_GLOBAL=1500
# CLIENT_IP_HEADER=               # off by default; e.g. true-client-ip ONLY after verifying the deployment
# ASSISTANT_PROMPT_VERSION=system_v2   # system_v1 kept for comparison
# TRUSTED_PROXY_HOPS=1
# RETRIEVAL_FUSION=weighted       # weighted | sql_rrf (legacy baseline)

# ---- Web (Next.js) : these ARE visible in the browser -------------------------
# --- Phase 2 (backend) ---
# JOB_EXECUTION=worker          # worker (persistent queue, default) | inline (tests/scripts)
# CRON_SECRET=                  # long random string; enables POST /api/v1/internal/sync/run-due
# OCR_PROVIDER=none             # none | tesseract (binary + kor/eng data) | ocr_space
# OCR_LANGUAGES=kor+eng         # tesseract languages (add vie, ind, chi_sim if installed)
# OCR_SPACE_API_KEY=            # free key from ocr.space (images are sent to that service)
# BOARD_MAX_ITEMS=5             # notices per SCH board sync (cap 30)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# publishable / anon key only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the FastAPI service, WITHOUT /api/v1. Inlined at build time: rebuild after changing.
# Required in production builds (no localhost fallback); NEXT_PUBLIC_API_BASE_URL is accepted as an alias.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Release candidate (all optional)
DATABASE_LIMIT_MB=500             # size of the database plan, only for the admin storage warning
RETRIEVAL_BRIDGE_WEIGHT=0.75      # Korean / English glossary search for questions in other languages; 0 = off
ASSISTANT_VERIFY_LOCAL=true       # second look at answers with figures; local models only, Gemini is never asked twice for it
SARAMIN_ACCESS_KEY=               # official recruitment API, secret; empty = the source stays blocked
DATA_GO_KR_SERVICE_KEY=           # public-institution recruitment API, secret; empty = the source stays blocked
