# =============================================================================
# SCH International Student Hub - environment variables (copy to .env, never commit .env)
# Backend reads ./.env or backend/.env ; the web app reads apps/web/.env.local
# =============================================================================

# ---- Backend (FastAPI) : SERVER-SIDE ONLY ------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server secret / service-role key. NEVER put this in the browser or in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects (Project Settings > API > JWT Secret). Projects with asymmetric
# signing keys are verified automatically through the JWKS endpoint; leave empty then.
SUPABASE_JWT_SECRET=
# Comma-separated, no trailing slash. CORS_ALLOWED_ORIGINS is accepted as an alias.
CORS_ORIGINS=http://localhost:3000
# Trusted domains the ingestion fetcher may contact (exact or subdomain match)
ALLOWED_SOURCE_DOMAINS=sch.ac.kr,studyinkorea.go.kr,hikorea.go.kr,topik.go.kr,nhis.or.kr,moel.go.kr
MAX_UPLOAD_MB=10
MAX_RESPONSE_MB=5
LOG_LEVEL=INFO

# Embeddings: e5 = intfloat/multilingual-e5-small (384-d, needs requirements-ml.txt)
#             hash = lexical stand-in for tests/offline dev ONLY (not semantic)
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
# Semantic-only matches below this cosine similarity are dropped (E5 scores cluster high; tune on real data)
RETRIEVAL_MIN_SIMILARITY=0.80

# Optional, future phase (answer generation). Core site works without it.
LLM_PROVIDER=none
LLM_API_KEY=

# ---- Web (Next.js) : these ARE visible in the browser -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# publishable / anon key only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the FastAPI service, WITHOUT /api/v1. Inlined at build time: rebuild after changing.
# Required in production builds (no localhost fallback); NEXT_PUBLIC_API_BASE_URL is accepted as an alias.
NEXT_PUBLIC_API_URL=http://localhost:8000
