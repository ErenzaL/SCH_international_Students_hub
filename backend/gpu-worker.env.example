# GPU worker on the university server. Copy to ~/.config/sch-gpu-worker/env (chmod 600). No token and no Supabase value
# belongs in this file: the token has its own file.
GPU_WORKER_HUB_URL=https://YOUR-API.onrender.com
GPU_WORKER_TOKEN_FILE=/home/YOUR-ACCOUNT/.config/sch-gpu-worker/token
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Only for the continuous mode. Every poll keeps a free Render instance awake for about 15 minutes.
GPU_WORKER_IDLE_MIN_SECONDS=300
GPU_WORKER_IDLE_MAX_SECONDS=3600
# GPU_WORKER_ACTIVE_HOURS=9-18      # Korea time
