# GPU worker on the university server. Copy to ~/.config/sch-gpu-worker/env (chmod 600). No token and no Supabase or
# Gemini value belongs in this file (the worker refuses to start next to them): the token has its own file
# (scripts/gpu_worker_token.sh writes it without showing it).
GPU_WORKER_HUB_URL=https://sch-hub-api.onrender.com
# The worker refuses the production API unless this names exactly the same host (a deliberate activation step).
GPU_WORKER_PRODUCTION_HOST=sch-hub-api.onrender.com
GPU_WORKER_TOKEN_FILE=/home/YOUR-ACCOUNT/.config/sch-gpu-worker/token
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Announcement drafts (ko/en/id): exactly this model; the server gives announcement jobs to no other model.
# Checked 2026-11-28: translategemma:12b, digest sha256:3189e9a01b8a..., Gemma 3, 12.2B, Q4_K_M.
OLLAMA_MODEL=translategemma:12b
# auto = the Hub's prompts with hints and repairs (measured better than TranslateGemma's own prompt)
GPU_WORKER_PROMPT_STYLE=auto
# Shared computer: take no job while less GPU memory is free (MiB); TranslateGemma 12B peaked at 9.7 GB. 0 = no check.
GPU_WORKER_MIN_FREE_VRAM_MB=9500
# Only for the continuous mode. Every poll keeps a free Render instance awake for about 15 minutes.
GPU_WORKER_IDLE_MIN_SECONDS=300
GPU_WORKER_IDLE_MAX_SECONDS=3600
# GPU_WORKER_ACTIVE_HOURS=9-18      # Korea time
